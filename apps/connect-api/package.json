{
  "name": "@hunsu/connect-api",
  "version": "0.1.1",
  "private": true,
  "description": "Hunsu Connect identity, device enrollment, and opaque peer-signaling service.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "config:print": "node --conditions=development scripts/cloudflare-config.mjs print",
    "config:write": "node --conditions=development scripts/cloudflare-config.mjs write",
    "types:worker": "node --conditions=development scripts/cloudflare-config.mjs types",
    "dev": "node --conditions=development scripts/cloudflare-config.mjs dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "build:worker": "node --conditions=development scripts/cloudflare-config.mjs build",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "deploy": "node --conditions=development scripts/cloudflare-config.mjs deploy",
    "db:migrate:local": "node --conditions=development scripts/cloudflare-config.mjs db:migrate:local",
    "db:migrate:remote": "node --conditions=development scripts/cloudflare-config.mjs db:migrate:remote"
  },
  "dependencies": {
    "@hunsu/config": "workspace:*",
    "@hunsu/protocol": "workspace:*",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260712.1",
    "wrangler": "4.110.0"
  }
}
