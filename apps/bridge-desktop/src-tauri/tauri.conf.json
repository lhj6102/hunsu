{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hunsu Bridge",
  "version": "0.1.0",
  "identifier": "app.hunsu.bridge",
  "build": {
    "frontendDist": "../dist-ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hunsu Bridge",
        "width": 860,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'none'; frame-ancestors 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Connect local Hunsu Roadmaps to Studio",
    "longDescription": "Hunsu Bridge starts and supervises the local Bridge runtime, opens Studio with local pairing, and prepares Remote Access.",
    "externalBin": [
      "../dist/hunsu-bridge-sidecar"
    ],
    "resources": [
      "../dist/hunsu-bridge-sidecar*",
      "../dist/sidecar-manifest.json"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "wix": {
        "language": "en-US",
        "fragmentPaths": [
          "windows/hunsu-protocol.wxs"
        ],
        "componentRefs": [
          "HunsuProtocolRegistry"
        ]
      }
    }
  },
  "plugins": {}
}
