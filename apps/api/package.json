{
  "name": "@hunsu/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --conditions=development --experimental-strip-types --watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hunsu/config": "workspace:*",
    "@hunsu/core": "workspace:*",
    "@hunsu/github-store": "workspace:*",
    "@hunsu/plugin-contract": "workspace:*",
    "@hunsu/projections": "workspace:*",
    "@hunsu/protocol": "workspace:*",
    "@hunsu/protocol-registry": "workspace:*",
    "fflate": "^0.8.2"
  }
}
