{
  "name": "@hunsu/local",
  "version": "0.1.0",
  "private": false,
  "description": "Hunsu localhost runtime and Studio API server.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hunsu/codex-runner": "workspace:*",
    "@hunsu/config": "workspace:*",
    "@hunsu/core": "workspace:*",
    "@hunsu/protocol": "workspace:*",
    "@hunsu/protocol-registry": "workspace:*"
  }
}
