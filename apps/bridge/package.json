{
  "name": "@hunsu/bridge",
  "version": "0.2.0-next.0",
  "private": false,
  "description": "Headless Hunsu Bridge daemon, authenticated CLI, and local Web API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhj6102/hunsu.git",
    "directory": "apps/bridge"
  },
  "type": "module",
  "bin": {
    "hunsu-bridge": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "development": "./src/package-api.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --conditions=development src/cli.ts dev",
    "bridge": "node --conditions=development src/cli.ts",
    "build": "node scripts/build.mjs",
    "pack-smoke": "node scripts/pack-smoke.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@hunsu/codex-runner": "workspace:*",
    "@hunsu/config": "workspace:*",
    "@hunsu/core": "workspace:*",
    "@hunsu/protocol": "workspace:*",
    "@hunsu/protocol-registry": "workspace:*",
    "esbuild": "0.27.7"
  }
}
